# Optional. Without a key the app runs on the built-in rules interpreter,
# which is also the production fallback when the model is down.
ANTHROPIC_API_KEY=

# Optional. Model used for language understanding.
SWITCHBOARD_MODEL=claude-haiku-5-5

# Optional spend caps for the public demo. Past a cap, turns fall back to the
# rules interpreter instead of calling the model.
SWITCHBOARD_MAX_CALLS_PER_VISITOR=40
SWITCHBOARD_MAX_TURNS_PER_CALL=16
SWITCHBOARD_DAILY_MODEL_CALLS=1500
